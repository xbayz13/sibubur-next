# Next.js Frontend Environment Variables
# Copy this file to .env.local for development or .env.production for production

# API Base URL
# Development: http://localhost:3000
# Production: http://72.61.208.109:3000
# 
# Untuk development, copy file ini ke .env.local dan set:
# NEXT_PUBLIC_API_URL=http://localhost:3000
#
# Untuk production, copy file ini ke .env.production dan set:
# NEXT_PUBLIC_API_URL=http://72.61.208.109:3000
NEXT_PUBLIC_API_URL=http://localhost:3000

# Node Environment
# Options: development, production
# Development: NODE_ENV=development (default)
# Production: NODE_ENV=production
NODE_ENV=development

# Next.js Port (optional, default is 3001)
# PORT=3001
